Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  performance-*,
  portability-*,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-using,
  readability-duplicate-include,
  readability-redundant-string-init
WarningsAsErrors: ''
HeaderFilterRegex: '^(include|src)/'
FormatStyle: file
